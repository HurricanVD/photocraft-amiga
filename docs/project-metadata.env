PROJECT_ID=photocraft-amiga
PROJECT_NAME=PhotoCraft AmigaOS 3.2 Port
# Uppercase letter plus uppercase letter or digit, derived from the
# repo/product abbreviation, e.g. VC or A2. Two letters preferred.
STORY_ID_PREFIX=PF
TEST_ID_PREFIX=PF
TARGET_OS=AmigaOS 3.2
TARGET_NDK=NDK 3.2
TARGET_HARDWARE_CLASS=highend-amiga
CPU_BASELINE=68040+
RAM_BASELINE=32MB Fast RAM
GUI_STACK=ReAction
# Allowed baseline options: VBCC or GCC_BEBBO. App repos choose one explicitly.
PRIMARY_TOOLCHAIN=GCC_BEBBO
VD_PROCESS_REPO=../../tools/vd-amiga-dev-process
# amiga-reaction-starter is the default; process-overlay is an explicit opt-out.
STARTER_APP_PROFILE=process-overlay
STARTER_APP_TEMPLATE=${VD_PROCESS_REPO}/docs/templates/starter-app
STARTER_APP_TARGET=build/photocraft-amiga
STARTER_APP_BUILD_COMMAND=make all
STARTER_APP_BUILD_RESULT=not_run
STARTER_APP_NOT_RUN_REASON=process-overlay
# Allowed not-run reasons: process-overlay|user_deactivated|n/a
NDK_ROOT=
NDK_INCLUDE_H=
VBCC=vc
GCC_BEBBO=
# Additive GCC/Bebbo migration metadata. These fields become mandatory only
# after a future process-version promotion of the 16.1 reference toolchain.
#GCC_BEBBO_VERSION=16.1
#GCC_BEBBO_BUILD=20260629
#GCC_BEBBO_SOURCE_COMMIT=<exact-commit-or-not_applicable>
#GCC_BEBBO_REFERENCE_IMAGE=stefanreinauer/amiga-gcc:gcc-v16.1-20260629
#GCC_BEBBO_REFERENCE_DIGEST=sha256:bf095c48f4f0383912bdbb362289882486e8de72b37dbd05dd8a94b04a76baf9
#GCC_BEBBO_BASELINE_CHANNEL=reference
#GCC_BEBBO_MIGRATION_STATUS=planned
#GCC_BEBBO_COMPATIBILITY_LANE=6.5.0b
VXLIBS_REPO=vxlibs
VXLIBS_POLICY=use_ready_components
VXLIBS_BASELINE_STATUS=ready_components_available
# Exact process pin; app-local checks should compare this to VD_PROCESS_REPO/VERSION.
VD_PROCESS_VERSION=0.2.1
VD_PROCESS_ADOPTION=overlay

# --- IP-/Third-Party-Governance. Consumer repos choose the project-specific
# --- values explicitly when they adopt a process version that activates this
# --- gate. See docs/process/ip-and-third-party-governance.md.
PROJECT_DISTRIBUTION_MODEL=open_source
# Suggested values: open_source|proprietary|commercial|internal|mixed|unspecified
PROJECT_IP_MODEL=mixed
# Suggested values: own|open_source_dependencies|third_party_licensed|mixed|unspecified
THIRD_PARTY_POLICY=review_required
REFERENCE_SOURCE_POLICY=no_copy_without_explicit_rights
IP_PROVENANCE_REGISTER=ports/amigaos3/docs/ip-provenance-register.md
RELEASE_IP_MANIFEST=ports/amigaos3/docs/release-ip-manifest.md

# --- Optional app-local release/Aminet metadata (fill when the repo ships
# --- releases; values are app-local, the process repo defines only the keys).
#PROJECT_VERSION=
#PROJECT_AUTHOR=
#PROJECT_LICENSE=
#PROJECT_SHORT_DESCRIPTION=
#PROJECT_RELEASE_DIR=
#PROJECT_RELEASE_ARCHIVE=
#PROJECT_RELEASE_BINARY=
#PROJECT_RELEASE_ICON=
#PROJECT_AMINET_TYPE=
#PROJECT_ARCHITECTURE=m68k-amigaos >= 3.2
